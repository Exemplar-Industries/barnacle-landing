{% comment %}
  ============================================================
  THE BARNACLE — Shopify Liquid Landing Page Section
  Compatible with: Dawn theme — native Shopify line item properties, zero app dependency
  
  HOW TO USE:
  1. In Shopify Admin → Online Store → Themes → Dawn → Edit Code
  2. Under "Sections", click "Add a new section" → name it "barnacle-landing"
  3. Paste this entire file content
  4. In your page template (or home page), add:
       {% section 'barnacle-landing' %}
  5. All customization fields (Base Color, Ring Pattern, Custom Text, Font Style,
     Text Color, Reference Image) are captured as native Shopify line item
     properties — no app required. Data appears in the order admin view,
     order confirmation email, and any webhook payload automatically.
  
  SCHEMA at bottom allows customization in the Theme Editor.
  ============================================================
{% endcomment %}

{%- assign current_product = section.settings.product -%}
{%- if current_product == blank -%}
  {%- assign current_product = all_products['the-barnacle-v2'] -%}
{%- endif -%}
{%- assign current_variant = current_product.selected_or_first_available_variant -%}

<style>
  /* ============================================================
     HIDE DAWN HEADER, FOOTER, AND ANNOUNCEMENT BAR
     The barnacle landing page owns 100% of the viewport.
  ============================================================ */
  body.barnacle-page header,
  body.barnacle-page .shopify-section-header,
  body.barnacle-page #shopify-section-header,
  body.barnacle-page site-header,
  body.barnacle-page .header-wrapper,
  body.barnacle-page footer,
  body.barnacle-page .footer,
  body.barnacle-page #shopify-section-footer,
  body.barnacle-page .shopify-section-footer,
  body.barnacle-page .announcement-bar,
  body.barnacle-page #shopify-section-announcement-bar,
  body.barnacle-page .shopify-section-group-header-group {
    display: none !important;
  }
  body.barnacle-page {
    padding-top: 0 !important;
    margin-top: 0 !important;
  }
  body.barnacle-page main {
    padding-top: 0 !important;
    margin-top: 0 !important;
  }

  /* Scoped to this section to avoid conflicts with Dawn base styles */
  .barnacle-section * { box-sizing: border-box; }

  /* ---- HERO ---- */
  .barnacle-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .barnacle-hero__bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;
    background-size: cover; background-position: center 30%;
  }
  .barnacle-hero__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(15,23,42,.45) 0%, rgba(15,23,42,.55) 60%, rgba(15,23,42,.75) 100%);
  }
  .barnacle-hero__content {
    position: relative; z-index: 2;
    text-align: center; padding: 80px 24px 120px;
    max-width: 820px; margin: 0 auto;
  }
  .barnacle-hero__eyebrow {
    display: inline-block;
    font-size: .75rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase;
    color: #0ea5e9;
    background: rgba(14,165,233,.15); border: 1px solid rgba(14,165,233,.4);
    padding: 6px 16px; border-radius: 50px;
    margin-bottom: 28px;
  }
  .barnacle-hero__title {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    font-weight: 900; line-height: 1.08; letter-spacing: -.02em;
    color: #fff; margin-bottom: 24px;
  }
  .barnacle-hero__title em { font-style: normal; color: #0ea5e9; }
  .barnacle-hero__sub {
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    color: rgba(255,255,255,.82); line-height: 1.65;
    max-width: 560px; margin: 0 auto 44px;
  }
  .barnacle-hero__ctas { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .barnacle-btn-primary {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    background: #0ea5e9; color: #fff;
    font-size: 1rem; font-weight: 700;
    padding: 16px 36px; border-radius: 50px; border: none; cursor: pointer;
    transition: background .2s, transform .15s;
    box-shadow: 0 4px 20px rgba(14,165,233,.35);
    text-decoration: none;
  }
  .barnacle-btn-primary:hover { background: #0284c7; transform: translateY(-2px); }
  .barnacle-btn-outline {
    display: inline-flex; align-items: center; justify-content: center;
    background: transparent; color: #fff;
    font-size: 1rem; font-weight: 700;
    padding: 14px 32px; border-radius: 50px;
    border: 2px solid rgba(255,255,255,.6); cursor: pointer;
    transition: background .2s; text-decoration: none;
  }
  .barnacle-btn-outline:hover { background: rgba(255,255,255,.12); border-color: #fff; }

  /* ---- BUY SECTION ---- */
  .barnacle-buy { padding: 96px 0; background: #fff; }
  .barnacle-buy__grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start;
    max-width: 1200px; margin: 0 auto; padding: 0 24px;
  }
  .barnacle-gallery__main {
    border-radius: 12px; overflow: hidden; aspect-ratio: 1/1;
    background: #f8fafc; cursor: zoom-in;
  }
  .barnacle-gallery__main img { width: 100%; height: 100%; object-fit: cover; transition: opacity .18s; }
  .barnacle-gallery__thumbs { display: flex; gap: 10px; margin-top: 12px; }
  .barnacle-gallery__thumb {
    width: 72px; height: 72px; border-radius: 8px; overflow: hidden;
    border: 2px solid transparent; cursor: pointer; flex-shrink: 0; background: #f8fafc;
    transition: border-color .2s;
  }
  .barnacle-gallery__thumb.active, .barnacle-gallery__thumb:hover { border-color: #0ea5e9; }
  .barnacle-gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }

  .barnacle-product__label {
    font-size: .7rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    color: #0ea5e9; margin-bottom: 10px;
  }
  .barnacle-product__title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 900; letter-spacing: -.03em; color: #0f172a; margin-bottom: 16px;
  }
  .barnacle-product__tagline { font-size: 1.05rem; color: #475569; line-height: 1.6; margin-bottom: 28px; }
  .barnacle-price-block { display: flex; align-items: baseline; gap: 12px; margin-bottom: 32px; }
  .barnacle-price { font-size: 2.2rem; font-weight: 900; color: #0f172a; }
  .barnacle-price-note { font-size: .85rem; color: #475569; }

  /* ---- CUSTOMIZER ---- */
  .barnacle-customizer {
    background: #f8fafc; border-radius: 16px;
    padding: 24px 28px; margin-bottom: 28px;
    border: 1px solid #e2e8f0;
  }
  .barnacle-customizer__header {
    display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;
  }
  .barnacle-customizer__label {
    font-size: .75rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: #475569;
  }
  .barnacle-customizer__badge {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: .68rem; font-weight: 600; color: #16a34a;
    background: #dcfce7; border-radius: 50px; padding: 3px 10px;
  }
  .barnacle-customizer__badge::before { content: '●'; font-size: .55rem; }
  .barnacle-field { margin-bottom: 20px; }
  .barnacle-field:last-child { margin-bottom: 0; }
  .barnacle-field__label {
    display: flex; align-items: center; justify-content: space-between;
    font-size: .78rem; font-weight: 700; color: #0f172a; margin-bottom: 10px;
  }
  .barnacle-field__selected {
    font-size: .75rem; font-weight: 500; color: #0ea5e9;
  }
  /* Swatch grid */
  .barnacle-swatches { display: flex; flex-wrap: wrap; gap: 8px; }
  .barnacle-swatch {
    position: relative; width: 40px; height: 40px;
    border-radius: 50%; border: 3px solid transparent;
    cursor: pointer; transition: border-color .15s, transform .15s;
    outline: none;
  }
  .barnacle-swatch:hover { transform: scale(1.1); }
  .barnacle-swatch.selected { border-color: #0ea5e9; box-shadow: 0 0 0 2px #fff, 0 0 0 4px #0ea5e9; }
  .barnacle-swatch input[type=radio] { position: absolute; opacity: 0; width: 0; height: 0; }
  .barnacle-swatch__dot {
    width: 100%; height: 100%; border-radius: 50%;
    border: 1px solid rgba(0,0,0,.12);
  }
  /* Pattern swatches (larger, rectangular) */
  .barnacle-pattern-swatches { display: flex; flex-wrap: wrap; gap: 8px; }
  .barnacle-pattern-swatch {
    position: relative; padding: 8px 16px;
    border-radius: 8px; border: 2px solid #e2e8f0;
    cursor: pointer; transition: border-color .15s, background .15s;
    font-size: .8rem; font-weight: 600; color: #475569;
    background: #fff;
  }
  .barnacle-pattern-swatch:hover { border-color: #94a3b8; color: #0f172a; }
  .barnacle-pattern-swatch.selected { border-color: #0ea5e9; background: rgba(14,165,233,.06); color: #0ea5e9; }
  .barnacle-pattern-swatch input[type=radio] { position: absolute; opacity: 0; width: 0; height: 0; }
  /* Text input */
  .barnacle-text-input {
    width: 100%; padding: 12px 16px;
    border: 2px solid #e2e8f0; border-radius: 10px;
    font-size: .95rem; color: #0f172a; background: #fff;
    outline: none; transition: border-color .15s;
    font-family: inherit;
  }
  .barnacle-text-input:focus { border-color: #0ea5e9; }
  .barnacle-text-input::placeholder { color: #94a3b8; }
  .barnacle-char-count { font-size: .7rem; color: #94a3b8; text-align: right; margin-top: 4px; }
  .barnacle-char-count.warn { color: #f59e0b; }
  /* Font picker */
  .barnacle-font-options { display: flex; flex-wrap: wrap; gap: 8px; }
  .barnacle-font-option {
    position: relative; padding: 10px 18px;
    border-radius: 8px; border: 2px solid #e2e8f0;
    cursor: pointer; transition: border-color .15s, background .15s;
    font-size: .95rem; color: #475569; background: #fff;
  }
  .barnacle-font-option:hover { border-color: #94a3b8; }
  .barnacle-font-option.selected { border-color: #0ea5e9; background: rgba(14,165,233,.06); color: #0f172a; }
  .barnacle-font-option input[type=radio] { position: absolute; opacity: 0; width: 0; height: 0; }
  .barnacle-font-block { font-family: 'Impact', 'Arial Black', sans-serif; font-weight: 900; }
  .barnacle-font-script { font-family: 'Georgia', 'Times New Roman', serif; font-style: italic; }
  .barnacle-font-military { font-family: 'Courier New', 'Courier', monospace; font-weight: 700; letter-spacing: .05em; }
  .barnacle-font-sans { font-family: 'Arial', 'Helvetica', sans-serif; font-weight: 600; }
  /* Image reference */
  .barnacle-img-ref {
    width: 100%; padding: 12px 16px;
    border: 2px solid #e2e8f0; border-radius: 10px;
    font-size: .9rem; color: #0f172a; background: #fff;
    outline: none; transition: border-color .15s;
    font-family: inherit;
  }
  .barnacle-img-ref:focus { border-color: #0ea5e9; }
  .barnacle-img-ref::placeholder { color: #94a3b8; }
  .barnacle-field__hint { font-size: .72rem; color: #94a3b8; margin-top: 5px; }

  .barnacle-features { list-style: none; margin-bottom: 36px; display: flex; flex-direction: column; gap: 14px; }
  .barnacle-features li { display: flex; align-items: flex-start; gap: 12px; font-size: .95rem; color: #1e293b; line-height: 1.5; }
  .barnacle-feat-icon {
    width: 36px; height: 36px; border-radius: 8px;
    background: rgba(14,165,233,.1); flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; font-size: 1rem;
  }
  .barnacle-features strong { display: block; font-weight: 700; color: #0f172a; }

  /* Shopify product form — Optus hooks into this standard form */
  .barnacle-product-form { display: flex; flex-direction: column; gap: 12px; }
  .barnacle-atc-btn {
    width: 100%; padding: 18px 24px;
    font-size: 1.05rem; font-weight: 800;
    background: #0f172a; color: #fff;
    border: none; border-radius: 50px; cursor: pointer;
    transition: background .2s, transform .15s;
    box-shadow: 0 4px 20px rgba(15,23,42,.25);
  }
  .barnacle-atc-btn:hover { background: #1e293b; transform: translateY(-2px); }
  .barnacle-trust { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; font-size: .78rem; color: #475569; margin-top: 4px; }
  .barnacle-trust span { display: flex; align-items: center; gap: 5px; }

  /* ---- FEATURE GRID ---- */
  .barnacle-features-section { padding: 96px 0; background: #f8fafc; }
  .barnacle-features-section .inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .barnacle-section-header { text-align: center; margin-bottom: 72px; }
  .barnacle-section-eyebrow {
    font-size: .7rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase;
    color: #0ea5e9; margin-bottom: 14px;
  }
  .barnacle-section-title {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 900; letter-spacing: -.025em; color: #0f172a;
    max-width: 600px; margin: 0 auto;
  }
  .barnacle-feature-row {
    display: grid; grid-template-columns: 1fr 1fr;
    overflow: hidden; border-radius: 12px;
    box-shadow: 0 4px 24px rgba(15,23,42,.12);
    margin-bottom: 40px;
  }
  .barnacle-feature-row.reverse { direction: rtl; }
  .barnacle-feature-row.reverse > * { direction: ltr; }
  .barnacle-feature-img { aspect-ratio: 4/5; overflow: hidden; }
  .barnacle-feature-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
  .barnacle-feature-img:hover img { transform: scale(1.04); }
  .barnacle-feature-text {
    background: #fff; display: flex; flex-direction: column; justify-content: center;
    padding: 56px 52px;
  }
  .barnacle-ft-eyebrow {
    font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    color: #0ea5e9; margin-bottom: 16px;
  }
  .barnacle-ft-title {
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 900; letter-spacing: -.02em; color: #0f172a;
    line-height: 1.15; margin-bottom: 18px;
  }
  .barnacle-ft-body { font-size: 1rem; color: #475569; line-height: 1.7; }
  .barnacle-feat-pill {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: .78rem; font-weight: 700; color: #0f172a;
    background: #f8fafc; border-radius: 50px; padding: 6px 14px; margin-top: 24px; align-self: flex-start;
  }

  /* ---- STICKY BAR ---- */
  .barnacle-sticky {
    position: fixed; bottom: 0; left: 0; right: 0; z-index: 999;
    background: #0f172a; padding: 14px 24px;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    box-shadow: 0 -4px 24px rgba(15,23,42,.25);
    transform: translateY(100%); transition: transform .35s cubic-bezier(.4,0,.2,1);
  }
  .barnacle-sticky.visible { transform: translateY(0); }
  .barnacle-sticky__name { font-size: .85rem; font-weight: 800; color: #fff; }
  .barnacle-sticky__price { font-size: .8rem; color: rgba(255,255,255,.6); }
  .barnacle-sticky__btn {
    flex-shrink: 0; background: #0ea5e9; color: #fff;
    font-size: .85rem; font-weight: 800;
    padding: 12px 28px; border-radius: 50px; border: none; cursor: pointer;
    transition: background .2s;
  }
  .barnacle-sticky__btn:hover { background: #0284c7; }

  /* ---- FOOTER ---- */
  .barnacle-footer { background: #0f172a; padding: 64px 0 32px; color: rgba(255,255,255,.6); }
  .barnacle-footer__inner {
    max-width: 1200px; margin: 0 auto; padding: 0 24px;
    display: flex; flex-direction: column; align-items: center; gap: 40px; text-align: center;
  }
  .barnacle-footer__brand { font-size: 1.4rem; font-weight: 900; color: #fff; }
  .barnacle-footer__brand span { color: #0ea5e9; }
  .barnacle-footer__email { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
  .barnacle-footer__email input {
    padding: 12px 20px; border-radius: 50px; border: 1px solid rgba(255,255,255,.2);
    background: rgba(255,255,255,.08); color: #fff; font-size: .9rem; min-width: 260px; outline: none;
  }
  .barnacle-footer__email input::placeholder { color: rgba(255,255,255,.4); }
  .barnacle-footer__email button {
    padding: 12px 28px; border-radius: 50px; border: none;
    background: #0ea5e9; color: #fff; font-size: .9rem; font-weight: 700; cursor: pointer;
  }
  .barnacle-footer__links { display: flex; gap: 24px; flex-wrap: wrap; justify-content: center; font-size: .8rem; }
  .barnacle-footer__links a { color: rgba(255,255,255,.5); text-decoration: none; }
  .barnacle-footer__links a:hover { color: #fff; }
  .barnacle-footer__copy { font-size: .75rem; color: rgba(255,255,255,.3); }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 900px) {
    .barnacle-buy__grid { grid-template-columns: 1fr; gap: 40px; }
    .barnacle-feature-row { grid-template-columns: 1fr; }
    .barnacle-feature-row.reverse { direction: ltr; }
    .barnacle-feature-img { aspect-ratio: 16/9; }
    .barnacle-feature-text { padding: 40px 32px; }
  }
  @media (max-width: 600px) {
    .barnacle-buy { padding: 64px 0; }
    .barnacle-features-section { padding: 64px 0; }
    .barnacle-feature-text { padding: 32px 24px; }
    .barnacle-sticky { padding: 12px 16px; }
  }
</style>

<!-- HERO -->
<section class="barnacle-hero" id="barnacle-hero">
  <div class="barnacle-hero__bg" style="background-image:url('https://cdn.shopify.com/s/files/1/0701/8437/0218/t/3/assets/hero-hydro-wide.png?v=1774008255')"></div>
  <div class="barnacle-hero__overlay"></div>
  <div class="barnacle-hero__content">
    <div class="barnacle-hero__eyebrow">The Barnacle &mdash; Portable Beverage Holder</div>
    <h1 class="barnacle-hero__title">
      {{ section.settings.hero_headline | default: 'Built for boats, <em>perfected</em> for everywhere else.' }}
    </h1>
    <p class="barnacle-hero__sub">
      {{ section.settings.hero_subheadline | default: 'The portable, multi-use beverage holder designed to fit cans and cups of all sizes. Secure your drink on the water, on the trail, or on the tailgate.' }}
    </p>
    <div class="barnacle-hero__ctas">
      <a href="#barnacle-buy" class="barnacle-btn-primary">Get Your Barnacle</a>
      <a href="#barnacle-features" class="barnacle-btn-outline">See It In Action</a>
    </div>
  </div>
</section>

<!-- BUY / PRODUCT SECTION -->
<section class="barnacle-buy" id="barnacle-buy">
  <div class="barnacle-buy__grid">

    <!-- Gallery -->
    <div class="barnacle-gallery">
      <div class="barnacle-gallery__main">
        <img id="barnacle-main-img"
          src="{{ current_product.featured_image | image_url: width: 800 }}"
          alt="{{ current_product.featured_image.alt | escape }}" />
      </div>
      <div class="barnacle-gallery__thumbs" id="barnacle-thumbs">
        {%- for image in current_product.images limit: 5 -%}
        <div class="barnacle-gallery__thumb{% if forloop.first %} active{% endif %}"
          data-src="{{ image | image_url: width: 800 }}">
          <img src="{{ image | image_url: width: 150 }}" alt="{{ image.alt | escape }}" />
        </div>
        {%- endfor -%}
      </div>
    </div>

    <!-- Conversion Column -->
    <div class="barnacle-product-info">
      <div class="barnacle-product__label">Free Shipping &bull; Ships in 2&ndash;3 Days</div>
      <h2 class="barnacle-product__title">{{ current_product.title }}</h2>
      <p class="barnacle-product__tagline">{{ section.settings.product_tagline | default: "Your drink's new best friend — on the water, on the road, or at the tailgate." }}</p>

      <div class="barnacle-price-block">
        <span class="barnacle-price">{{ current_variant.price | money }}</span>
        <span class="barnacle-price-note">USD &bull; Free returns</span>
      </div>

      <!-- CUSTOMIZER — Native Shopify line item properties, zero app dependency -->
      <div class="barnacle-customizer" id="barnacle-customizer">
        <div class="barnacle-customizer__header">
          <div class="barnacle-customizer__label">Customize Your Barnacle</div>
          <div class="barnacle-customizer__badge">Live Preview</div>
        </div>

        <!-- BASE COLOR -->
        <div class="barnacle-field" id="field-base-color">
          <div class="barnacle-field__label">
            <span>Base Color</span>
            <span class="barnacle-field__selected" id="selected-base-color">Black</span>
          </div>
          <div class="barnacle-swatches">
            <label class="barnacle-swatch selected" title="Black" data-field="base-color" data-value="Black">
              <input type="radio" name="barnacle_base_color" value="Black" checked />
              <div class="barnacle-swatch__dot" style="background:#1a1a1a;"></div>
            </label>
            <label class="barnacle-swatch" title="White" data-field="base-color" data-value="White">
              <input type="radio" name="barnacle_base_color" value="White" />
              <div class="barnacle-swatch__dot" style="background:#f8fafc;"></div>
            </label>
            <label class="barnacle-swatch" title="Navy" data-field="base-color" data-value="Navy">
              <input type="radio" name="barnacle_base_color" value="Navy" />
              <div class="barnacle-swatch__dot" style="background:#1e3a5f;"></div>
            </label>
            <label class="barnacle-swatch" title="OD Green" data-field="base-color" data-value="OD Green">
              <input type="radio" name="barnacle_base_color" value="OD Green" />
              <div class="barnacle-swatch__dot" style="background:#4a5c3a;"></div>
            </label>
            <label class="barnacle-swatch" title="Tan" data-field="base-color" data-value="Tan">
              <input type="radio" name="barnacle_base_color" value="Tan" />
              <div class="barnacle-swatch__dot" style="background:#c4a882;"></div>
            </label>
            <label class="barnacle-swatch" title="Red" data-field="base-color" data-value="Red">
              <input type="radio" name="barnacle_base_color" value="Red" />
              <div class="barnacle-swatch__dot" style="background:#c0392b;"></div>
            </label>
          </div>
        </div>

        <!-- RING PATTERN -->
        <div class="barnacle-field" id="field-ring-pattern">
          <div class="barnacle-field__label">
            <span>Ring Pattern</span>
            <span class="barnacle-field__selected" id="selected-ring-pattern">Solid</span>
          </div>
          <div class="barnacle-pattern-swatches">
            <label class="barnacle-pattern-swatch selected" data-field="ring-pattern" data-value="Solid">
              <input type="radio" name="barnacle_ring_pattern" value="Solid" checked />
              Solid
            </label>
            <label class="barnacle-pattern-swatch" data-field="ring-pattern" data-value="Stripe">
              <input type="radio" name="barnacle_ring_pattern" value="Stripe" />
              Stripe
            </label>
            <label class="barnacle-pattern-swatch" data-field="ring-pattern" data-value="Camo">
              <input type="radio" name="barnacle_ring_pattern" value="Camo" />
              Camo
            </label>
            <label class="barnacle-pattern-swatch" data-field="ring-pattern" data-value="Custom">
              <input type="radio" name="barnacle_ring_pattern" value="Custom" />
              Custom
            </label>
          </div>
        </div>

        <!-- CUSTOM TEXT -->
        <div class="barnacle-field" id="field-custom-text">
          <div class="barnacle-field__label">
            <span>Custom Text <span style="font-weight:400;color:#94a3b8;">(optional)</span></span>
          </div>
          <input
            type="text"
            class="barnacle-text-input"
            id="barnacle-custom-text"
            placeholder="e.g. SEMPER FI, LAKE LIFE, your name..."
            maxlength="20"
            autocomplete="off"
          />
          <div class="barnacle-char-count" id="barnacle-char-count">0 / 20 characters</div>
        </div>

        <!-- FONT STYLE -->
        <div class="barnacle-field" id="field-font-style">
          <div class="barnacle-field__label">
            <span>Font Style</span>
            <span class="barnacle-field__selected" id="selected-font-style">Block</span>
          </div>
          <div class="barnacle-font-options">
            <label class="barnacle-font-option barnacle-font-block selected" data-field="font-style" data-value="Block">
              <input type="radio" name="barnacle_font_style" value="Block" checked />
              Block
            </label>
            <label class="barnacle-font-option barnacle-font-script" data-field="font-style" data-value="Script">
              <input type="radio" name="barnacle_font_style" value="Script" />
              Script
            </label>
            <label class="barnacle-font-option barnacle-font-military" data-field="font-style" data-value="Military">
              <input type="radio" name="barnacle_font_style" value="Military" />
              Military
            </label>
            <label class="barnacle-font-option barnacle-font-sans" data-field="font-style" data-value="Sans">
              <input type="radio" name="barnacle_font_style" value="Sans" />
              Sans
            </label>
          </div>
        </div>

        <!-- TEXT COLOR -->
        <div class="barnacle-field" id="field-text-color">
          <div class="barnacle-field__label">
            <span>Text Color</span>
            <span class="barnacle-field__selected" id="selected-text-color">White</span>
          </div>
          <div class="barnacle-swatches">
            <label class="barnacle-swatch" title="Black" data-field="text-color" data-value="Black">
              <input type="radio" name="barnacle_text_color" value="Black" />
              <div class="barnacle-swatch__dot" style="background:#1a1a1a;"></div>
            </label>
            <label class="barnacle-swatch selected" title="White" data-field="text-color" data-value="White">
              <input type="radio" name="barnacle_text_color" value="White" checked />
              <div class="barnacle-swatch__dot" style="background:#f8fafc;"></div>
            </label>
            <label class="barnacle-swatch" title="Gold" data-field="text-color" data-value="Gold">
              <input type="radio" name="barnacle_text_color" value="Gold" />
              <div class="barnacle-swatch__dot" style="background:#d4a017;"></div>
            </label>
            <label class="barnacle-swatch" title="Red" data-field="text-color" data-value="Red">
              <input type="radio" name="barnacle_text_color" value="Red" />
              <div class="barnacle-swatch__dot" style="background:#c0392b;"></div>
            </label>
          </div>
        </div>

        <!-- REFERENCE IMAGE -->
        <div class="barnacle-field" id="field-image-ref">
          <div class="barnacle-field__label">
            <span>Reference Image URL <span style="font-weight:400;color:#94a3b8;">(optional)</span></span>
          </div>
          <input
            type="url"
            class="barnacle-img-ref"
            id="barnacle-image-ref"
            placeholder="https://... or leave blank and email us"
            autocomplete="off"
          />
          <div class="barnacle-field__hint">Paste a link to your logo, artwork, or reference image. You can also email it to us after ordering.</div>
        </div>

      </div>

      <!-- Feature Bullets -->
      <ul class="barnacle-features">
        <li>
          <div class="barnacle-feat-icon">🔄</div>
          <div><strong>Multi-use &amp; Versatile Fit</strong>Holds cans, bottles, and tumblers of virtually any size.</div>
        </li>
        <li>
          <div class="barnacle-feat-icon">⚓</div>
          <div><strong>Marine-Friendly Materials</strong>UV-resistant and waterproof — built for salt air, sun, and spray.</div>
        </li>
        <li>
          <div class="barnacle-feat-icon">🌡️</div>
          <div><strong>Heat &amp; Cold Safe</strong>Won't warp in the sun or crack in the cold.</div>
        </li>
        <li>
          <div class="barnacle-feat-icon">🏗️</div>
          <div><strong>Durable Construction</strong>Grips any flat surface — no screws, no mess.</div>
        </li>
      </ul>

      <!-- Shopify Product Form — line item properties carry all customization data through to the order -->
      {%- form 'product', current_product, id: 'barnacle-product-form', class: 'barnacle-product-form' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" />

        {%- unless current_product.has_only_default_variant -%}
          {%- for option in current_product.options_with_values -%}
            <select name="options[{{ option.name | escape }}]" id="Option-{{ option.position }}" style="display:none;">
              {%- for value in option.values -%}
                <option value="{{ value | escape }}"
                  {%- if option.selected_value == value %} selected="selected"{% endif %}>
                  {{ value }}
                </option>
              {%- endfor -%}
            </select>
          {%- endfor -%}
        {%- endunless -%}

        <!-- LINE ITEM PROPERTIES — these are passed to every order, visible in admin, confirmation email, and webhooks -->
        <input type="hidden" name="properties[Base Color]" id="prop-base-color" value="Black" />
        <input type="hidden" name="properties[Ring Pattern]" id="prop-ring-pattern" value="Solid" />
        <input type="hidden" name="properties[Custom Text]" id="prop-custom-text" value="" />
        <input type="hidden" name="properties[Font Style]" id="prop-font-style" value="Block" />
        <input type="hidden" name="properties[Text Color]" id="prop-text-color" value="White" />
        <input type="hidden" name="properties[Reference Image]" id="prop-image-ref" value="" />

        <button type="submit" name="add" class="barnacle-atc-btn"
          {%- unless current_variant.available %} disabled{% endunless %}>
          {%- if current_variant.available -%}
            Add to Cart &mdash; {{ current_variant.price | money }}
          {%- else -%}
            Sold Out
          {%- endif -%}
        </button>
      {%- endform -%}

      <div class="barnacle-trust">
        <span>🔒 Secure Checkout</span>
        <span>🚚 Free Shipping</span>
        <span>↩️ Easy Returns</span>
      </div>
    </div>
  </div>
</section>

<!-- FEATURE GRID -->
<section class="barnacle-features-section" id="barnacle-features">
  <div class="inner">
    <div class="barnacle-section-header">
      <div class="barnacle-section-eyebrow">In The Wild</div>
