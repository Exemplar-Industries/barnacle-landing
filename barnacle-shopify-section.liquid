<!-- STICKY BAR -->
<div class="barnacle-sticky" id="barnacle-sticky">
  <div>
    <div class="barnacle-sticky__name">The Barnacle</div>
    <div class="barnacle-sticky__price">{{ current_variant.price | money }} &bull; Free Shipping</div>
  </div>
  <button class="barnacle-sticky__btn"
    onclick="document.querySelector('#barnacle-product-form [name=add]').click()">
    Add to Cart
  </button>
</div>

<!-- FOOTER -->
<footer class="barnacle-footer">
  <div class="barnacle-footer__inner">
    <div class="barnacle-footer__brand">The <span>Barnacle</span></div>
    {%- form 'customer', class: 'barnacle-footer__email' -%}
      <input type="hidden" name="contact[tags]" value="newsletter" />
      <input type="email" name="contact[email]" placeholder="Your email address" required aria-label="Email" />
      <button type="submit">Join the Crew</button>
    {%- endform -%}
    <div class="barnacle-footer__links">
      <a href="{{ pages['privacy-policy'].url | default: '/policies/privacy-policy' }}">Privacy Policy</a>
      <a href="{{ pages['terms-of-service'].url | default: '/policies/terms-of-service' }}">Terms of Service</a>
      <a href="{{ pages['shipping-policy'].url | default: '/policies/shipping-policy' }}">Shipping &amp; Returns</a>
      <a href="/pages/contact">Contact</a>
    </div>
    <div class="barnacle-footer__copy">&copy; {{ 'now' | date: '%Y' }} The Barnacle. All rights reserved.</div>
  </div>
</footer>

<script>
  /* Gallery thumbnails */
  document.querySelectorAll('.barnacle-gallery__thumb').forEach(function(thumb) {
    thumb.addEventListener('click', function() {
      document.querySelectorAll('.barnacle-gallery__thumb').forEach(function(t) { t.classList.remove('active'); });
      thumb.classList.add('active');
      var img = document.getElementById('barnacle-main-img');
      img.style.opacity = '0';
      setTimeout(function() { img.src = thumb.dataset.src; img.style.opacity = '1'; }, 180);
    });
  });
  document.getElementById('barnacle-main-img').style.transition = 'opacity .18s';

  /* Sticky bar */
  var buySection = document.getElementById('barnacle-buy');
  var stickyBar = document.getElementById('barnacle-sticky');
  if (buySection && stickyBar) {
    var obs = new IntersectionObserver(function(entries) {
      stickyBar.classList.toggle('visible', !entries[0].isIntersecting);
    }, { threshold: 0.1 });
    obs.observe(buySection);
  }

  /* ---- CUSTOMIZER: sync UI selections to hidden line item property inputs ---- */
  (function() {
    // Swatch selectors (color swatches)
    document.querySelectorAll('.barnacle-swatch').forEach(function(swatch) {
      swatch.addEventListener('click', function() {
        var field = swatch.dataset.field;
        var value = swatch.dataset.value;
        // Deselect siblings
        document.querySelectorAll('.barnacle-swatch[data-field="' + field + '"]').forEach(function(s) {
          s.classList.remove('selected');
        });
        swatch.classList.add('selected');
        swatch.querySelector('input[type=radio]').checked = true;
        // Update label
        var labelEl = document.getElementById('selected-' + field);
        if (labelEl) labelEl.textContent = value;
        // Update hidden property input
        var propMap = { 'base-color': 'prop-base-color', 'text-color': 'prop-text-color' };
        var propId = propMap[field];
        if (propId) document.getElementById(propId).value = value;
      });
    });

    // Pattern swatches
    document.querySelectorAll('.barnacle-pattern-swatch').forEach(function(swatch) {
      swatch.addEventListener('click', function() {
        var field = swatch.dataset.field;
        var value = swatch.dataset.value;
        document.querySelectorAll('.barnacle-pattern-swatch[data-field="' + field + '"]').forEach(function(s) {
          s.classList.remove('selected');
        });
        swatch.classList.add('selected');
        swatch.querySelector('input[type=radio]').checked = true;
        var labelEl = document.getElementById('selected-' + field);
        if (labelEl) labelEl.textContent = value;
        document.getElementById('prop-ring-pattern').value = value;
      });
    });

    // Font options
    document.querySelectorAll('.barnacle-font-option').forEach(function(opt) {
      opt.addEventListener('click', function() {
        var field = opt.dataset.field;
        var value = opt.dataset.value;
        document.querySelectorAll('.barnacle-font-option[data-field="' + field + '"]').forEach(function(o) {
          o.classList.remove('selected');
        });
        opt.classList.add('selected');
        opt.querySelector('input[type=radio]').checked = true;
        var labelEl = document.getElementById('selected-' + field);
        if (labelEl) labelEl.textContent = value;
        document.getElementById('prop-font-style').value = value;
      });
    });

    // Custom text input
    var textInput = document.getElementById('barnacle-custom-text');
    var charCount = document.getElementById('barnacle-char-count');
    if (textInput) {
      textInput.addEventListener('input', function() {
        var len = textInput.value.length;
        charCount.textContent = len + ' / 20 characters';
        charCount.classList.toggle('warn', len >= 16);
        document.getElementById('prop-custom-text').value = textInput.value;
      });
    }

    // Image reference input
    var imgRef = document.getElementById('barnacle-image-ref');
    if (imgRef) {
      imgRef.addEventListener('input', function() {
        document.getElementById('prop-image-ref').value = imgRef.value;
      });
    }

    // Guard: ensure required fields are filled before add to cart
    var form = document.getElementById('barnacle-product-form');
    if (form) {
      form.addEventListener('submit', function(e) {
        var baseColor = document.getElementById('prop-base-color').value;
        if (!baseColor) {
          e.preventDefault();
          alert('Please select a Base Color before adding to cart.');
        }
      });
    }
  })();
</script>

