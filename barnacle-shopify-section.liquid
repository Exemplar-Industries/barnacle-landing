{%- liquid
  assign current_product = section.settings.product | default: all_products['the-barnacle-v2']
  if current_product == blank
    assign current_product = all_products['the-barnacle-v2']
  endif
  assign current_variant = current_product.selected_or_first_available_variant
-%}

<style>
/* ============================================================
   HIDE DAWN HEADER / FOOTER / ANNOUNCEMENT BAR
============================================================ */
.barnacle-page-active #shopify-section-header,
.barnacle-page-active header.header,
.barnacle-page-active .header-wrapper,
.barnacle-page-active sticky-header,
.barnacle-page-active #shopify-section-announcement-bar,
.barnacle-page-active .announcement-bar,
.barnacle-page-active footer.footer,
.barnacle-page-active #shopify-section-footer,
.barnacle-page-active .shopify-section-group-header-group {
  display: none !important;
}
.barnacle-page-active #MainContent,
.barnacle-page-active main {
  padding-top: 0 !important;
  margin-top: 0 !important;
}
/* Zero out ALL Shopify section wrapper padding/margin */
.barnacle-page-active .shopify-section,
.barnacle-page-active .shopify-section-group-main-group > .shopify-section {
  padding: 0 !important;
  margin: 0 !important;
}

/* ============================================================
   RESET
============================================================ */
#bl *, #bl *::before, #bl *::after { box-sizing: border-box; margin: 0; padding: 0; }
#bl {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  background: #fff; color: #0f172a;
  -webkit-font-smoothing: antialiased; line-height: 1.5;
  --navy: #0f172a; --slate: #1e293b; --mid: #475569;
  --light: #f8fafc; --white: #ffffff;
  --accent: #0ea5e9; --accent-dark: #0284c7;
  --r: 12px; --shadow: 0 4px 24px rgba(15,23,42,.12);
}
#bl a { text-decoration: none; color: inherit; }

/* ============================================================
   BUTTONS
============================================================ */
#bl .btn-p {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  background: var(--accent); color: #fff;
  font-size: 1rem; font-weight: 700; letter-spacing: .02em;
  padding: 16px 36px; border-radius: 50px; border: none; cursor: pointer;
  transition: background .2s, transform .15s, box-shadow .2s;
  box-shadow: 0 4px 20px rgba(14,165,233,.35); white-space: nowrap;
  text-decoration: none; font-family: inherit;
}
#bl .btn-p:hover { background: var(--accent-dark); transform: translateY(-2px); }
#bl .btn-o {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  background: transparent; color: #fff; font-size: 1rem; font-weight: 700;
  padding: 14px 32px; border-radius: 50px; border: 2px solid rgba(255,255,255,.6);
  cursor: pointer; transition: background .2s, border-color .2s; text-decoration: none;
}
#bl .btn-o:hover { background: rgba(255,255,255,.12); border-color: #fff; }

/* ============================================================
   HERO
============================================================ */
#bl #hero {
  position: relative; min-height: 100vh;
  display: flex; align-items: center; justify-content: center; overflow: hidden;
}
#bl .hero-bg {
  position: absolute; inset: 0; width: 100%; height: 100%;
  overflow: hidden;
}
#bl .hero-bg img {
  width: 100%; height: 100%; object-fit: cover; object-position: center 60%; display: block;
}
#bl .hero-ov {
  position: absolute; inset: 0;
  background: linear-gradient(to bottom, rgba(10,18,35,.35) 0%, rgba(10,18,35,.52) 55%, rgba(10,18,35,.78) 100%);
}

#bl .hero-content {
  position: relative; z-index: 2;
  text-align: center; padding: 80px 24px 120px; max-width: 820px;
}
#bl .eyebrow {
  display: inline-block; font-size: .75rem; font-weight: 700; letter-spacing: .15em;
  text-transform: uppercase; color: var(--accent);
  background: rgba(14,165,233,.15); border: 1px solid rgba(14,165,233,.4);
  padding: 6px 16px; border-radius: 50px; margin-bottom: 28px;
}
#bl #hero h1 {
  font-size: clamp(2.6rem, 6.5vw, 5rem); font-weight: 900; line-height: 1.06;
  letter-spacing: -.025em; color: #fff; margin-bottom: 24px;
}
#bl #hero h1 em { font-style: normal; color: var(--accent); }
#bl .hero-sub {
  font-size: clamp(1rem, 2.2vw, 1.2rem); color: rgba(255,255,255,.82);
  line-height: 1.65; max-width: 560px; margin: 0 auto 44px;
}
#bl .hero-ctas { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
#bl .scroll-hint {
  position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
  z-index: 2; color: rgba(255,255,255,.45); font-size: .7rem; letter-spacing: .1em;
  text-transform: uppercase; display: flex; flex-direction: column; align-items: center; gap: 4px;
}
#bl .scroll-hint span { animation: bl-bounce 2s infinite; display: block; }
@keyframes bl-bounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(6px)} }

/* ============================================================
   CONTAINER
============================================================ */
#bl .wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

/* ============================================================
   FEATURES SECTION
============================================================ */
#bl #features { padding: 96px 0; background: var(--light); }
#bl .sec-head { text-align: center; margin-bottom: 72px; }
#bl .sec-eye { font-size: .7rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--accent); margin-bottom: 14px; }
#bl .sec-title { font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-weight: 900; letter-spacing: -.025em; color: var(--navy); max-width: 680px; margin: 0 auto 16px; }
#bl .sec-sub { font-size: 1rem; color: var(--mid); max-width: 520px; margin: 0 auto; line-height: 1.65; }

#bl .pain-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; margin-bottom: 80px; }
#bl .pain-card { background: #fff; border-radius: var(--r); padding: 32px 28px; box-shadow: var(--shadow); }
#bl .pain-icon { font-size: 2rem; margin-bottom: 16px; }
#bl .pain-card h3 { font-size: 1.05rem; font-weight: 800; color: var(--navy); margin-bottom: 10px; }
#bl .pain-card p { font-size: .9rem; color: var(--mid); line-height: 1.65; }

#bl .feat-row {
  display: grid; grid-template-columns: 1fr 1fr;
  overflow: hidden; border-radius: var(--r); box-shadow: var(--shadow); margin-bottom: 40px;
}
#bl .feat-row:last-child { margin-bottom: 0; }
#bl .feat-row.rev { direction: rtl; }
